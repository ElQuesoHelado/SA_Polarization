\begin{tikzpicture}[x=1cm,y=1cm,>=Latex,
 box/.style={draw=black!25,rounded corners=2mm,fill=black!2,
   text width=4.6cm,minimum height=1.55cm,align=center,
   execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000},font=\sffamily\small,inner sep=3mm},
 leftbox/.style={box,text width=6cm,draw=blue!50!black,fill=blue!3},
 rightbox/.style={box,text width=6cm,draw=teal!65!black,fill=teal!3},
 flow/.style={->,line width=.8pt,draw=black!65},
 lab/.style={font=\sffamily\small,fill=white,inner sep=2pt}]
\node[box] (api) at (2.5,0) {\includegraphics[height=6mm]{docs/figures/youtube_icon.pdf}\\
  \textbf{Data extraction}\\YouTube Data API · comments and replies};
\node[box] (prep) at (8.5,0) {{\Large\faFilter}\\
  \textbf{Preparation}\\Dates, provenance, and deduplication};
\node[box] (corpus) at (14.5,0) {{\Large\faDatabase}\\
  \textbf{Comment collection}\\Frozen study data};
\draw[flow] (api)--(prep); \draw[flow] (prep)--(corpus);
\node[leftbox] (users) at (4.2,-2.6) {{\Large\faUsers}\\
  \textbf{Histories of 300 users}\\First users in the fixed order; all their comments};
\node[rightbox] (benchmark) at (12.8,-2.6) {{\Large\faClipboardList}\\
  \textbf{Evaluation sample}\\3,000 comments; annotated targets and evaluations};
\draw[flow] (corpus.south)--++(0,-.3)-|(users.north);
\draw[flow] (corpus.south)--++(0,-.3)-|(benchmark.north);
\node[leftbox] (targets) at (4.2,-4.9) {{\Large\faTags}\\
  \textbf{Comment--target evaluation}\\Explicit mentions and events by political bloc};
\node[rightbox] (train) at (12.8,-4.9) {{\Large\faMicrochip}\\
  \textbf{Training · Kaggle GPU}\\Three references and two additional models\\Three seeds per model};
\draw[flow] (users)--(targets);
\node[leftbox] (ab) at (4.2,-7.2) {{\Large\faProjectDiagram}\\
  \textbf{A/B video split}\\A: observed political affinity\\B: affective comparison};
\node[rightbox] (eval) at (12.8,-7.2) {{\Large\faBalanceScale}\\
  \textbf{Classifier evaluation}\\End-to-end extraction and common context};
\draw[flow] (targets)--(ab);
\draw[flow] (train)--node[lab,right]{Predictions}(eval);
\draw[flow] (benchmark.east)--++(.65,0)|-node[lab,pos=.65,right]{Reference}(eval.east);
\node[leftbox] (measure) at (4.2,-10.7) {{\Large\faChartBar}\\
  \textbf{Observational measurement}\\AP\textsubscript{In}, AP\textsubscript{Out}, AP, dispersion\\Normalized gap, intervals, and support\\Sensitivity and individual stability};
\node[rightbox] (models) at (12.8,-10.7) {{\Large\faChartLine}\\
  \textbf{Model comparison}\\Per-class F1, coverage, and errors};
\draw[flow] (ab)--(measure); \draw[flow] (eval)--(models);
\end{tikzpicture}
